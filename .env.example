# =============================================================================
# QueueCare — Environment Configuration Template
# Copy this file to .env.local for local overrides
# =============================================================================

# Three-Terminal Process Ports
PORT=3000
BACKEND_PORT=5001
BACKEND_URL=http://127.0.0.1:5001

# Primary Relational Engine: 'sqlite' (embedded local dev) or 'mysql' (academic MySQL 8.0)
DB_TYPE=mysql

# MySQL 8.0 Configuration (Used when DB_TYPE=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=queuecare_user
DB_PASSWORD=queuecare_pass
DB_NAME=queuecare

# Application Security
SESSION_SECRET=queuecare_secure_jwt_session_secret_key_2026
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=QueueCare

# Redis Caching Layer (Optional - Graceful In-Memory Fallback Active)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Neo4j Graph Database (Level 3 Multi-Model Paradigm - Graceful Fallback Active)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
